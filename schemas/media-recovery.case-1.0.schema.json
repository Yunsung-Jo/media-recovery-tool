{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-recovery-tool.local/schemas/media-recovery.case-1.0.schema.json",
  "title": "Media Recovery Tool case metadata 1.0",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "required_features",
    "case_id",
    "created_at",
    "label",
    "source"
  ],
  "properties": {
    "schema": {"const": "media-recovery.case"},
    "schema_version": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$"},
    "required_features": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "case_id": {"type": "string", "pattern": "^case-[0-9a-f]{20}$"},
    "created_at": {"type": "string"},
    "label": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
