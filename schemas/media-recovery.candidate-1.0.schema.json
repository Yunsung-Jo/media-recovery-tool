{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-recovery-tool.local/schemas/media-recovery.candidate-1.0.schema.json",
  "title": "Media Recovery Tool forensic candidate record 1.0",
  "$comment": "Fingerprint recomputation, reference resolution, manifest ownership, and NPZ integrity are enforced by the Python reader.",
  "type": "object",
  "required": [
    "schema", "schema_version", "required_features", "engine_version", "policy_version",
    "object_id", "candidate_ordinal", "candidate_id", "candidate_fingerprint", "hypotheses",
    "source_spans", "decode_segments", "virtual_edits", "placements", "coefficient_manifest"
  ],
  "properties": {
    "schema": {"const": "media-recovery.candidate"},
    "schema_version": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$"},
    "required_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "engine_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "pattern": "^(jpeg|avi)-[0-9a-f]{16}$"},
    "candidate_ordinal": {"type": "integer", "minimum": 0, "maximum": 999},
    "candidate_id": {"type": "string", "pattern": "^cand-[0-9]{3}$"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hypotheses": {
      "type": "array",
      "items": {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.forensic-defs-1.0.schema.json#/$defs/hypothesis"}
    },
    "source_spans": {
      "type": "array",
      "items": {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.forensic-defs-1.0.schema.json#/$defs/sourceSpan"}
    },
    "decode_segments": {
      "type": "array",
      "items": {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.forensic-defs-1.0.schema.json#/$defs/decodeSegment"}
    },
    "virtual_edits": {
      "type": "array",
      "items": {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.forensic-defs-1.0.schema.json#/$defs/virtualEdit"}
    },
    "placements": {
      "type": "array",
      "items": {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.forensic-defs-1.0.schema.json#/$defs/placement"}
    },
    "coefficient_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "https://media-recovery-tool.local/schemas/media-recovery.coefficient-manifest-1.0.schema.json"}
      ]
    }
  },
  "additionalProperties": true
}
